rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function settingsPath() {
      return /databases/$(database)/documents/bankMeta/P665/settings/config;
    }
    function emailIsAdmin() {
      return signedIn()
        && exists(settingsPath())
        && request.auth.token.email in get(settingsPath()).data.adminEmails;
    }
    function adminPath() {
      return /databases/$(database)/documents/bankMeta/P665/admins/$(request.auth.uid);
    }
    function isAdmin() {
      return emailIsAdmin() || (
        signedIn()
        && exists(adminPath())
        && get(adminPath()).data.role == 'ADMIN'
        && get(adminPath()).data.status == 'ACTIVE'
      );
    }

    // Shared Accounts — preserve schema; customers cannot mutate balances
    match /accounts/{accountId} {
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Shared Ledger — append-only
    match /ledgerEntries/{entryId} {
      allow read: if signedIn() && (
        isAdmin()
        || get(/databases/$(database)/documents/accounts/$(resource.data.accountId)).data.customerUid == request.auth.uid
      );
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /bankMeta/P665/settings/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /bankMeta/P665/admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && emailIsAdmin()
        && request.resource.data.role == 'ADMIN'
        && request.resource.data.status == 'ACTIVE';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /bankMeta/P665/counters/{doc} {
      allow read, write: if isAdmin();
    }

    match /bankMeta/P665/applications/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.customerUid == request.auth.uid;
      allow update: if isAdmin()
        || (isSelf(uid)
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.customerUid == request.auth.uid);
      allow delete: if false;
    }

    match /bankMeta/P665/customers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /bankMeta/P665/loans/{loanId} {
      allow read: if isAdmin() || resource.data.customerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.customerUid == resource.data.customerUid
      );
      allow delete: if false;
    }

    match /bankMeta/P665/beneficiaries/{id} {
      allow read, delete: if signedIn() && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.customerUid == request.auth.uid;
    }

    match /bankMeta/P665/notifications/{id} {
      allow read, update: if signedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
    }

    match /bankMeta/P665/auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /bankMeta/P665/cashRequests/{id} {
      allow read: if isAdmin() || resource.data.customerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
